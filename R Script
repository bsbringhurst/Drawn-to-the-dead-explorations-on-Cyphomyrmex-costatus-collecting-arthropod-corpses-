#Figure 3A - NMDS of All Chemicals
#NMDS plot for all sample types with all chemicals
library(dplyr)
library(ggplot2)

# Read in the data
nmds_data <- read.csv("BP_costatus_all.csv")

# Collapse replicates to colony means
nmds_colony <- nmds_data %>%
  group_by(Colony, Type) %>%
  summarize(
    MDS1 = mean(MDS1, na.rm = TRUE),
    MDS2 = mean(MDS2, na.rm = TRUE)
  )

ggplot(nmds_colony, aes(x = MDS1, y = MDS2, color = Type)) +
  geom_point(size = 3) +
