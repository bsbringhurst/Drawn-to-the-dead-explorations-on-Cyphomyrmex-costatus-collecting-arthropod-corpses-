#Figure 2 - Necromass Taxonomic Heatmap
library(vegan)
library(RColorBrewer)
library(ComplexHeatmap)
library(circlize)

#Makes count data proportions for each colony, so proportion of each genus out of the colony's community
data_transformed <- decostand(df_1, method = "total")

#Convert the data to a numeric matrix
data_matrix <- as.matrix(data_transformed)

#Assign row names (colony labels)
rownames(data_matrix) <- colony_genus_data$Colony_Code

#Remove initials from colony names (RMMA, ACG, SKM, etc.)
rownames(data_matrix) <- substr(rownames(data_matrix), 7, nchar(rownames(data_matrix)))

#Create heatmap color palette
col_fun2 <- colorRamp2(
  seq(min(data_matrix), max(data_matrix), length.out = 3),
  c("navyblue", "green4", "yellow2")
)

# Create the heatmap with row names set to 'Colony_Code'
ht1 <- Heatmap(
  data_matrix,
  cluster_rows = FALSE,
  cluster_columns = FALSE,
  col = col_fun2,
  column_names_gp = gpar(fontsize = 14, fontface = "italic"),
  column_names_rot = 45,
  column_names_side = "top",
  row_names_side = "left",
  row_names_gp = gpar(fontsize = 9),
  row_names_max_width = unit(10, "cm"),
  heatmap_legend_param = list(title = "Scale")
)

draw(ht1)


