#Figure 3B - NMDS for CHC only
# Read in the data for NMDS for CHC ONLY
nmds_chc_data <- read.csv("CHCONLY_CostausNMDS.csv")

# Collapse replicates to colony means
nmds_chc_colony <- nmds_chc_data %>%
  group_by(Colony, Type) %>%
  summarize(
    MDS1 = mean(MDS1, na.rm = TRUE),
    MDS2 = mean(MDS2, na.rm = TRUE)
  )

ggplot(nmds_chc_colony, aes(x = MDS1, y = MDS2, color = Type)) +
  geom_point(size = 3) +
  stat_ellipse(type = "norm", level = 0.95, linewidth = 1) +
  theme_minimal(base_size = 18) +
  labs(x = "NMDS1", y = "NMDS2", color = "Sample Type") +
  scale_color_manual(values = c(
    "Fungus Garden" = "green4",
    "Necromass"    = "black",
    "Workers"      = "orange"
  )) +
  theme(
    axis.title = element_text(face = "bold"),
    axis.text = element_text(face = "bold"),
    legend.title = element_text(face = "bold")
  )

# If you only have NMDS scores (MDS1, MDS2), you can still test:
dist_matrix <- dist(nmds_chc_colony[, c("MDS1", "MDS2")])  # Euclidean distance

# Run PERMANOVA
adonis_result <- adonis2(dist_matrix ~ Type, data = nmds_chc_colony, permutations = 999)

# View results
adonis_result

# Unique Types
types <- unique(nmds_chc_colony$Type)

# Create empty list to store results
pairwise_results <- list()

# Loop through all pairwise combinations
for(i in 1:(length(types)-1)){
  for(j in (i+1):length(types)){
    subset_data <- nmds_chc_colony[nmds_chc_colony$Type %in% c(types[i], types[j]), ]
    dist_subset <- dist(subset_data[, c("MDS1", "MDS2")])
    
    adonis_res <- adonis2(dist_subset ~ Type, data = subset_data, permutations = 9999)
    
    pairwise_results[[paste(types[i], "vs", types[j])]] <- adonis_res
  }
}

# View results
pairwise_results


