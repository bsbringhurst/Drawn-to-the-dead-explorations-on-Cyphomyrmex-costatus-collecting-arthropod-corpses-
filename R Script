#Mantel Test for Community Similarity by Distance
library(readxl)
library(gplots)
library(vegan)
library(geosphere)
library(dplyr)
library(tidyr)


#Input dataset
Data_gfg <- read_excel("Juno_Body_Parts.xlsx")

# Lumps the Excel sheet by colony code and by genus, creating one line for each colony
colony_genus_data <- Data_gfg %>%
  group_by(Colony_Code, Genera) %>%  # Replace with actual column names
  summarise(Count = n()) %>%
  pivot_wider(names_from = Genera, values_from = Count, values_fill = 0)

# Removes Colony_Code and unidentified taxa
df <- subset(colony_genus_data, select = -Colony_Code)
df_1 <- subset(df, select = -unidentified)

#Input GPS coordinates
coords <- read_excel("Long_Latv2.xlsx")

# Geographic distance matrix
geo_dist <- distm(coords, fun = distHaversine)

# Bray-Curtis dissimilarity
eco_dist <- vegdist(df_1, method = "bray")

#Mantel test between geographic distance matrix and Bray-Curtis dissimilarity
mantel_test <- mantel(eco_dist, geo_dist, method = "spearman", permutations = 9999, na.rm = TRUE)  # Mantel test
print(mantel_test)


