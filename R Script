#"Ant Head" Choice Assays
#Inputting observed data
observed.washed <- c(0,1,1,3,10,8)
observed.home <- c(2,2,1,4,11,10)

#Expected proportions
expected_proportions <- c(1/6, 1/6, 1/6,1/6,1/6,1/6)

#Performing the simulated Chi-Square goodness-of-fit tests with 10,000 replicates
chisq_test.washed <- chisq.test(
  x = observed.washed,
  p = expected_proportions,
  simulate.p.value = TRUE,
  B = 10000
)
print(chisq_test.washed)

chisq_test.home <- chisq.test(
  x = observed.home,
  p = expected_proportions,
  simulate.p.value = TRUE,
  B = 10000
)
print(chisq_test.home)
